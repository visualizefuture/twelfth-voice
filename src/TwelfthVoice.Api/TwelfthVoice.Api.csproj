<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Live match API: runs matches, streams personalised insights over SignalR, stores everything in SQL.</Description>
    <!-- Local secrets (Foundry key, endpoint): dotnet user-secrets set "AzureAI:ApiKey" "..." -->
    <UserSecretsId>twelfth-voice-api-7c1e5b9a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Lifts the version pulled in by Microsoft.Data.SqlClient past GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwelfthVoice.Domain\TwelfthVoice.Domain.csproj" />
    <ProjectReference Include="..\TwelfthVoice.Simulator\TwelfthVoice.Simulator.csproj" />
    <ProjectReference Include="..\TwelfthVoice.Intelligence\TwelfthVoice.Intelligence.csproj" />
    <ProjectReference Include="..\TwelfthVoice.Agents\TwelfthVoice.Agents.csproj" />
  </ItemGroup>

</Project>
