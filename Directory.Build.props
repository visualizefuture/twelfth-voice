<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Lets the apps run on a newer runtime if the exact one is not installed. -->
    <RollForward>Major</RollForward>
    <Authors>Twelfth Voice</Authors>
    <Product>Twelfth Voice</Product>
  </PropertyGroup>
</Project>
