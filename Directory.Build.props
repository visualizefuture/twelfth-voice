<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Lets the apps run on a newer runtime (e.g. .NET 9) if .NET 8 isn't installed. -->
    <RollForward>Major</RollForward>
    <Authors>Twelfth Voice</Authors>
    <Product>Twelfth Voice</Product>
  </PropertyGroup>
</Project>
